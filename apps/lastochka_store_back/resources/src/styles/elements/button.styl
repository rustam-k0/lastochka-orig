@import "~@/styles/mixins/svg.styl"
.btn {
  background none
  border none
  padding 0 35px
  height 50px
  font-weight: bold;
  font-size: 1em;
  line-height: 19px;
  border-radius 10px
  cursor pointer
  transition .2s
  display flex
  justify-content center
  text-align center
  align-items center
  gap 10px

  &:active {
    transform scale(0.95)
  }

  &:disabled {
    opacity 0.8
  }

  .icon {
    width 20px
    height 20px
    display flex
    flex-shrink 0

    svg {
      width 100%
      height 100%
      transition .2s
    }
  }

  &--main-outline {
    background transparent
    border 1px solid $main_color
    color $main_color
    font-weight normal

    .icon svg {
      svg($main_color)
    }

    ^[0]:active&
    ^[0]:hover& {
      border-color $main_color
      color $main_color

      .icon svg {
        svg($main_color)
      }
    }
  }

  &--main {
    background $main_color
    color $white
    font-weight normal

    .icon svg {
      svg($white)
    }

    ^[0]:active&
    ^[0]:hover& {
      background darken($main_color, 10%)
      color $white
    }
  }

  &--red {
    background $red
    color $white
    font-weight normal

    .icon svg {
      svg($white)
    }

    ^[0]:active&
    ^[0]:hover& {
      background darken($red, 10%)
      color $white
    }
  }

  &--red-outline {
    background transparent
    border 1px solid $red
    color $red
    font-weight normal

    .icon svg {
      svg($red)
    }

    ^[0]:active&
    ^[0]:hover& {
      border-color $red
      color $red

      .icon svg {
        svg($red)
      }
    }
  }

  &--medium {
    height 40px
    padding 0 25px
  }

  &--small {
    padding: 8px;
    height: auto;
    border-radius: 5px;
  }
}
