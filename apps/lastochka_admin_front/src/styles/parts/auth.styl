.auth {
  display flex
  align-items stretch
  justify-content stretch
  height 100vh

  &__left {
    max-width 784px
    width 100%
    display flex
    justify-content center
    align-items stretch
    padding 50px 0
    background var(--white)
  }

  &__left-container {
    max-width 400px
    width 100%
    display flex
    flex-direction column
    justify-content space-between
  }

  &__header {
    width 100%
    height 50px
    display flex
    justify-content flex-start

    .icon {
      height 100%
    }
  }

  &__logo-img {
    height 50px
    width auto
    object-fit contain
  }

  &__body {
    width 100%
    display grid
    grid-gap 40px
  }

  &__title {
    font-weight: 700;
    font-size: 2.125rem;
    line-height: 41px;
    color: var(--dark);
  }

  &__form {
    width 100%
    display grid
    grid-gap 16px
  }

  &__success {
    font-size 1rem
    line-height 1.5
    color var(--dark)
    margin 0
  }

  &__form-footer {
    display flex
    width 100%
    justify-content space-between
    align-items center
  }

  &__image {
    height 100%
    width: 100%;
    object-fit: cover;
  }

  &__right {
    height 100%
    width 100%
    overflow hidden
  }
}
