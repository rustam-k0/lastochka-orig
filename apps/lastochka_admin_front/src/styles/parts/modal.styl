.default-modal {
  z-index 1
  background: var(--white);
  display flex
  flex-direction column
  justify-content stretch
  align-items stretch
  position relative
  border-radius: 16px;

  &__header {
    display flex
    gap 16px
    align-items: center;
    width 100%
    padding 17px 32px
    border-bottom: 1px solid var(--white-2);
  }

  &__title {
    display: flex;
    align-items: center;
    margin 0
    font-weight: 500;
    font-size: 1.125em;
    line-height: 140%;
    color: var(--dark);
  }

  &__close {
    //position absolute
    //top 0
    //right 0
    background: var(--white);
    border: 1px solid #F9FAFA;
    width 32px
    height 32px
    background
    padding 0
    border-radius 6px
    transition var(--transition)
    display inline-flex
    align-items center
    justify-content center
    cursor pointer
    margin-left: auto

    .icon {
      width 20px
      height 20px

      svg path {
        //stroke var(--gray-800)
      }
    }

    &:hover {
      background var(--blue-200)
    }
  }

  &__back{
    width 40px
    height 40px
    background none
    padding 0
    border-radius var(--small_radius)
    border none
    transition var(--transition)
    display inline-flex
    align-items center
    justify-content center
    cursor pointer
    .icon {
      width 40px
      height 40px

      svg path {
        stroke var(--brown)
      }
    }

    &:hover {
      background var(--gray-3-dark)
    }
  }
  &__body {
    display flex
    flex-direction column
    align-items flex-start
    justify-content flex-start
    gap 16px
    width 100%
    padding 16px
  }

  &__footer {
    display: flex;
    gap 7px
    //flex-direction column
    //align-items center
    justify-content space-between
    width 100%
    padding 16px
    border-top: 1px solid var(--white-2);
  }
}
