.input {
  display inline-grid
  grid-gap 5px
  width 100%


  &__title {
    //font-weight: 400;
    //font-size: 0.813rem
    //line-height: 18px;
    //color: var(--black-2)
    font-weight: 400;
    font-size: 0.8125em;
    line-height: 20px;
    color: var(--dark);

    ^[0]--error & {
      color var(--red)
    }

    > span {
      color: var(--red);
    }
  }

  &--disabled {
    & ^[0]__field-label {
      background: var(--neutral-50)
    }

    & ^[0]__field input {
      color var(--body-color-o5)
    }
  }

  &__subtitle {
    font-weight: 500;
    font-size: 0.8125em;
    line-height: 140%;
    color: var(--dark);
    z-index 1
    flex-shrink 0
  }

  &--column {
    display flex
    flex-direction column
    height: 78px !important
    padding: 16px;
    gap: 32px;
  }

  &__field-label {
    position absolute
    left 0
    top 0
    width 100%
    height 100%
    cursor text
    background: var(--white)
    border 1px solid var(--border-color)
    border-radius: 6px;

    ^[0]--error & {
      background: var(--white);
      border-color var(--red);
    }

  }

  &__field {
    display flex
    //background var(--gray)
    //border 1px solid var(--dark-light)
    border-radius 5px
    gap 15px
    transition background .2s, box-shadow .2s, border-color .2s
    align-items stretch
    justify-content stretch
    padding-left 16px
    position relative
    padding-right 1px
    height 48px
    z-index 2

    & input {

      &::placeholder {
        font-weight: 400;
        font-size: 0.875rem
        line-height: 16px;
        color: var(--body-color)
      }

    }

    ^[0]--small & {
      height 32px
    }

    //^[0]--focused & {
    //  padding 0 15px
    //  padding-right 0
    //  background: var(--white);
    //  border: 2px solid var(--dark);
    //  box-shadow: 0 0 0 3px var(--main-o15);
    //}
    errorAndFocus = '^[0]--error^[0]--focused &';

    {errorAndFocus} {
      box-shadow: 0 0 0 3px var(--red-o15);
    }

    ^[0]--error & {
      background: var(--white);
      border-color var(--red);
    }

    textarea {
      height auto
      resize vertical
    }

    textarea,
    input {
      appearance none
      border none
      background none
      outline none
      height 100%
      width 100%
      font-weight: 500;
      font-size: 0.875rem
      line-height: 16px;
      color: var(--dark)
      z-index 1
    }

    button {
      height 100%
      background none
      border none
      padding 15px
      display inline-flex
      align-items center
      justify-content center
      z-index: 1;
    }

    .icon svg {
      z-index 10
      width 16px
      height 16px

      path {
        fill var(--gray-4)
      }
    }
  }

  &__errors,
  &__messages {
    font-weight: 400;
    font-size: 0.75rem;
    line-height: 15px;
    color: var(--dark);
    opacity: 0.4;
    display grid
    grid-gap 3px
  }

  &__errors {
    opacity 1
    color var(--red)
  }
}
