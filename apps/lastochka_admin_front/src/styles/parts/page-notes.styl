.notes {
  display flex
  flex-direction column
  gap 20px
  height 100%
  overflow hidden

  &__body {
    padding 20px
    background var(--white)
    border-radius 10px
    width 100%
    display flex
    flex-direction column
    gap 20px
    align-items stretch
    overflow hidden
  }

  &__title {
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 28px;
    color: var(--dark-light);
  }

  &__footer {
    padding 20px
    background var(--white)
    border-radius 10px
    width 100%

    .btn {
      width 100%
    }
  }

  &__list {
    overflow: auto;
    width 100%
    display flex
    flex-direction column
    gap 20px
    scrollbar-width thin
    scrollbar-color rgba(0, 0, 0, 0.3) transparent

    &::-webkit-scrollbar {
      width 8px
      height 8px
    }

    &::-webkit-scrollbar-track {
      background transparent
    }

    &::-webkit-scrollbar-thumb {
      background-clip: padding-box;
      background-color rgba(0, 0, 0, 0.3)
      border-radius 3px
      border none
    }
  }
}

.notes-item {
  display grid
  width 100%
  background: var(--gray);
  border-radius: 10px;
  border: 1px solid var(--gray-dark);

  &__body {
    padding 15px 20px
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 20px;
    display: grid;
    grid-gap 10px
    color: var(--dark);
    border-bottom: 1px solid var(--gray-dark);
  }

  &__footer {
    padding 5px 20px
    display grid
    grid-template-columns 1fr auto

    .tabs .btn--md {
      padding 0 10px
    }
  }

  &__footer-info {
    display grid
  }

  &__date,
  &__name {
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 20px;
    color: var(--dark-light);
  }

  &__date {
    font-size: 0.75rem;
  }
}
