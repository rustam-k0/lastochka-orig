.document {
  padding 15px 20px
  background var(--white)
  display flex
  align-items center
  gap 10px

  &__icon {
    width 50px
    height 50px
    background var(--gray)
    border-radius 100%

    svg {
      width 20px
      height 20px

      path {
        fill var(--dark)
      }
    }
  }

  &__title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 26px;
    color: var(--dark);
  }
  .btn {
    margin-left auto
  }
}
