.rows {

  &__indicator--green {
    display flex
    justify-content center
    align-items center
    width 22px
    height 28px
    background var(--green-light)
    border-radius 6px

    span {
      width 6px
      height 6px
      border-radius 999px
      background var(--green)
    }
  }

  &__indicator--gray {
    display flex
    justify-content center
    align-items center
    width 22px
    height 28px
    background var(--gray-9)
    border-radius 6px

    span {
      width 6px
      height 6px
      border-radius 999px
      background var(--gray-dark-2)
    }
  }

  &__indicator--red {
    display flex
    justify-content center
    align-items center
    width 22px
    height 28px
    background var(--red-o5)
    border-radius 6px

    span {
      width 6px
      height 6px
      border-radius 999px
      background var(--red)
    }
  }


  &__article {
    width fit-content
    font-size 0.813rem
    font-weight 400
    line-height 20px
    padding 5px 8px
    border 1px solid var(--border-color)
    border-radius 6px
    cursor pointer
  }

  &__center {
    width 100%
    font-size 0.813rem
    font-weight 400
    display flex
    justify-content center
    align-items center
    cursor pointer
  }

  &__left {
    width 100%
    font-size 0.813rem
    font-weight 400
    display flex
    justify-content flex-start
    align-items center
    cursor pointer
  }

  &__right {
    width 100%
    font-size 0.813rem
    font-weight 400
    display flex
    justify-content flex-end
    align-items center
  }

  &__empty {
    display flex
    justify-content flex-start
    align-items center
    width 100%
    height 100%
  }

  &__action {
    display flex
    position relative
    cursor pointer

    .icon {
      width 20px
      height 20px
    }
  }

  &__email {
    color var(--blue-2) !important
    text-decoration-line: underline;
    cursor pointer
  }

  &__phone {
    text-decoration-line: underline;
  }

  &__elipsis {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  &__img {
    width 45px
    height 45px

    img {
      width 100%
      height 100%
    }
  }
}
