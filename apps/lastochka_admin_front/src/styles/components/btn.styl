.btn {
  background none
  font-weight: 500;
  font-size: 0.813rem
  line-height: 20px;
  border-radius 6px
  padding: 14px 16px;
  background-color var(--main)
  border 1px solid transparent
  color var(--white)
  cursor pointer
  display inline-flex
  justify-content center
  text-align center
  align-items center
  gap 8px
  transition var(--transition)
  outline none

  &:active:not(:disabled) {

    transform scale(0.95)
    background-color var(--main-o9)
    color var(--white)
  }

  &:hover:not(:disabled) {
    background-color var(--main-o9)
    color var(--white)
  }

  &:disabled {
    opacity 0.8
    cursor not-allowed
  }

  .icon {
    transition var(--transition)

    svg {
      width 20px
      height 20px

      path {
        var(--transition)
        fill var(--white)
      }

    }
  }

  &--loading {
    background-size: 30px 30px;
    background-image: linear-gradient(-45deg, #00000040 25%, #0000 25%, #0000 50%, #00000040 50%, #00000040 75%, #0000 75%, #0000);
    animation: stripped 2s linear 0s infinite normal none running;
  }

  &--pagination {
    border none !important
    width 36px
    height 36px
    color var(--body-muted) !important
    border-radius 6px !important

    .icon svg {
     width 16px !important
     height 16px !important

     path {
      fill var(--body-muted) !important
     }
    }
  }

  &--pagination-active {
    color var(--dark) !important
    background: rgba(255, 255, 255, 0.5) !important
  }

  &--sm {
    height 32px
    font-size 0.813rem
    line-height: 20px;
    padding 7px
    gap 4px

    .icon {
      width 16px
      height 16px
    }
  }

  &--md {
    height 40px
    line-height 18px
    padding 14px 16px
  }

  &--lg {
    height 52px
    line-height: 18px;
    padding 16px
  }

  &--green {
    background-color var(--green-light)
    border 1px solid var(--green-light)
    color var(--main)

    &:hover:not(:disabled) {
      background-color var(--green-hover)
      border 1px solid var(--green-hover)

      .icon svg path {
        //transition var(--transition)
        fill var(--white)
      }
    }

    &:active:not(:disabled) {
      background-color var(--green-hover)

      .icon svg path {
        fill var(--white)
      }
    }

    .icon svg path {
      transition var(--transition)
      fill var(--white)
    }
  }

  &--dark {
    background-color var(--neutral-800)
    color var(--white)

    .icon svg path {
      fill var(--white)
    }

    &:hover:not(:disabled) {
      background-color var(--neutral-600)
      color var(--white)
    }

    &:active:not(:disabled) {
      background-color var(--neutral-800)
      color var(--white)
    }
  }

  &--white {
    background: var(--white)
    border: 1px solid var(--gray-light);
    color var(--dark)

    & .icon svg path {
      fill var(--dark)
    }

    &:hover:not(:disabled) {
      background-color var(--gray)
      color var(--dark-light)
    }

    &:active:not(:disabled) {
      background-color var(--gray)
      color var(--dark-light)
    }
  }


  &--gray {
    background: var(--neutral-50)
    color var(--dark)

    & .icon svg path {
      fill var(--dark)
    }

    &:hover:not(:disabled) {
      background-color var(--gray)
      color var(--dark-light)
    }

    &:active:not(:disabled) {
      background-color var(--gray)
      color var(--dark-light)
    }
  }


  &--danger {
    background-color var(--red-light)
    color var(--red)
    border-color var(--red-light-2)

    .icon svg path {
      fill var(--red)
    }

    &:hover:not(:disabled) {
      background-color var(--red-light-2)
      color var(--red)
    }

    &:active:not(:disabled) {
      background-color var(--gray)
      color var(--red)
    }
  }

  &--neutral {
    background-color var(--neutral-800)
    color var(--gray-8)

    .icon svg path {
      fill var(--gray-8)
    }

    &:hover:not(:disabled) {
      background-color var(--neutral-600)
      color var(--white)
    }

    &:active:not(:disabled) {
      background-color var(--neutral-800)
      color var(--white)
    }
  }
  &--warring {
    background-color var(--yellow-light)
    color var(--yellow)

    & .icon svg path {
      fill var(--yellow)
    }

    &:hover:not(:disabled) {
      background-color var(--dark)
    }

    &:active:not(:disabled) {
      background-color var(--dark)
    }
  }

  &--blue {
    border-color var(--gray-light)
    color var(--dark)
    background-color var(--blue)

    .icon svg path {
      fill var(--dark)
    }

    &:hover:not(:disabled) {
      background-color var(--gray-dark)
      color var(--dark)
    }

    &:active:not(:disabled) {
      background-color var(--gray-dark)
      color var(--dark)
    }
  }

  &--red {
    background-color var(--red)

    &:hover:not(:disabled) {
      background-color var(--red)
    }

    &:active:not(:disabled) {
      background-color var(--red)
    }
  }
}
