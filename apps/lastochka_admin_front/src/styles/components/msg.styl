.msg {
  display inline-flex
  padding 10px 15px
  background-color var(--green-o5)
  border 1px solid var(--green-o15)
  font-size 0.8750rem
  border-radius 5px
  color: var(--dark)
  justify-content flex-start

  &--yellow {
    background-color var(--yellow-o5)
    border 1px solid var(--yellow-o15)
  }

  &--red {
    background-color var(--red-o5)
    border 1px solid var(--red-o15)
  }
}
