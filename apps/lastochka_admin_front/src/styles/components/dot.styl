.dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;

  &--orange {
    background var(--yellow-dark)
  }

  &--blue {
    background var(--blue-2)
  }

  &--purple {
    background var(--pink)
  }

  &--unactive {
    background var(--neutral-600)
  }

  &--active {
    background var(--main)
  }
}
