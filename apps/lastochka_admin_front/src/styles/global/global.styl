* {
  font-family var(--font-regular)
  scroll-behavior smooth
  box-sizing border-box
  scrollbar-width auto
  scrollbar-color var(--main) var(--gray)
  margin: 0

  &::-webkit-scrollbar {
    width 8px
    height 8px
  }

  &::-webkit-scrollbar-track {
    background var(--gray)
  }

  &::-webkit-scrollbar-thumb {
    background-color var(--main)
    border-radius 3px
    border 1px solid var(--gray)
  }

  &::selection {
    background var(--main)
    color var(--white)
  }
}

figure {
  margin 0
  display inline-flex
  align-items center
  justify-content center
  flex-shrink 0
}

textarea {
  resize vertical
}

body {
  background var(--gray)
}

h2 {
  font-family: var(--font-bold)
  font-weight: 500;
  font-size: 1.5rem
  line-height: 34px
  color: #222128;
}

ol,
ul {
  list-style none
  padding 0
  margin 0
}

a {
  text-decoration none
  color var(--dark)
}

button {
  cursor pointer
}

pre {
  margin 0
  font-family var(--font-regular)
}

b {
  font-weight 700
}

hr {
  height 1px
  padding 0
  margin 0
  border 0
  width 100%
  background var(--gray-dark)
}

.icon svg {
  width 100%
  height 100%
}

.no-overflow {
  overflow hidden
}

.page {
  padding 16px 32px
  display flex
  flex-direction column
  gap 16px

  &--main{
    display flex
    flex-direction column
    gap 16px
    padding 16px 32px
    height 100%
    width 100%
    background var(--gray-3)
  }

  background var(--gray-3)
  min-height: calc(100vh - 70px);

  &__header {
    display flex
    justify-content space-between
    align-items center

    h2 {
      font-family var(--font-bold)
      margin 0
      font-weight 500
      font-size 1.5em
    }
  }
}
